AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your-api-key
AZURE_OPENAI_API_VERSION=2024-05-01-preview
AZURE_OPENAI_DEPLOYMENT_NAME=your-deployment-name
# AZURE_AGENT_ID removed — converter now uses Chat Completions exclusively.
# If you had this set previously, it's no longer read (safe to leave in .env,
# it's just ignored).

# Optional: hard ceiling on total tokens per conversion. Remaining files are
# skipped with SKIPPED_BUDGET once the cap is hit. Unset or 0 = no cap.
# Example (roughly $1 USD on gpt-4o): MAX_TOKENS_PER_CONVERSION=400000
# MAX_TOKENS_PER_CONVERSION=0

# Optional: when set, every outbound AI prompt is dumped as JSON to this dir.
# Useful for debugging "why did the AI make a weird choice?" — inspect the
# exact messages sent, including assembled context blocks. Off by default.
# DEBUG_PROMPTS=/tmp/cobol-converter-prompts
