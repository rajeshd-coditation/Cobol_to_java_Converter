# ============================================
# AI Provider Configuration
# ============================================
# Choose your AI provider: "openai" or "azure"
AI_PROVIDER=openai

# ============================================
# OpenAI Configuration
# ============================================
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# ============================================
# Azure OpenAI Configuration
# ============================================
# Get these values from Azure Portal → Azure OpenAI resource

# Endpoint: Azure Portal → Your Resource → Overview
# Example: https://your-resource-name.openai.azure.com
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com

# API Key: Azure Portal → Your Resource → Keys and Endpoint
AZURE_OPENAI_API_KEY=your-azure-api-key-here

# API Version: Use preview version for Agents
AZURE_OPENAI_API_VERSION=2024-05-01-preview

# Deployment Name: Azure Portal → Your Resource → Model deployments
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o

# (Optional) AI Foundry Agent ID: Azure AI Studio → Agents → Your Agent
# Only needed if using AI Foundry Agents API
AZURE_AGENT_ID=
